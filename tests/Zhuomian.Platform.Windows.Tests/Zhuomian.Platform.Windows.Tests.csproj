<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Zhuomian.Platform.Windows/Zhuomian.Platform.Windows.csproj" />
    <ProjectReference Include="../Zhuomian.LaunchFixture/Zhuomian.LaunchFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyLaunchFixture" AfterTargets="Build">
    <ItemGroup>
      <FixtureFiles Include="../Zhuomian.LaunchFixture/bin/$(Configuration)/net9.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)fixture" />
  </Target>
</Project>
